{
  "manifest_version": 3,
  "name": "Phrase Replacer",
  "version": "1.0.0",
  "description": "Find and replace phrases on any web page, with per-rule case and whole-word options.",
  "minimum_chrome_version": "88",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Phrase Replacer",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/replacer.js", "src/content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
